{
  "manifest_version": 3,
  "name": "ext-reload helper",
  "version": "1.4.0",
  "description": "Lets your coding agent, or any shell, reload your unpacked extensions, so you are never asked to press Reload at chrome://extensions.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ext-reload helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "key": "",
  "permissions": [
    "management",
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "sw.js"
  }
}
